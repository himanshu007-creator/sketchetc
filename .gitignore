.DS_Store
config/.fs_guard.log
config/.fs_guard_prompted
config/.fs_guard_off
config/.loc
config/.theme
# compiled helpers are built on the user machine, never committed
config/plugins/bin/*
!config/plugins/bin/*.swift

# runtime state, per machine - never belongs in the repo
config/.last_seen_version
config/.update_state
config/.update_notified_*
config/.update_skip
config/.popup_open
config/.iconset
config/.notify_sound
# user-owned config lives in ~/.config/sketchetc, never in the checkout
config/.theme
config/.iconset
config/.notify_sound
config/.extras_collapsed
